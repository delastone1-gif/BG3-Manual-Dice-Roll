# BG3 Mod Development - Gitignore

# Build artifacts
*.pak

# Development directories (keep local only)
v1.2.0-dev/
Mod to Investigate/

# Claude Code directory (DO NOT commit)
.claude/

# Cheat tables and reference files
*.CT

# Temporary build files
temp_pack/
verify_pak/
/tmp/
pak_temp/
lslib/

# Backup files
*.bak
*.backup
*~

# System files
Thumbs.db
.DS_Store
desktop.ini
nul

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Test and debug files
test_*.lua
debug_*.lua

# Local build scripts (user-specific paths)
build.ps1
build.bat
BUILD.md
pack_mod.sh
PACKING_MODS.md

# Nexus publishing files (keep local only)
NEXUS_DESCRIPTION_*.txt
NEXUS_FILE_DESCRIPTION.txt
NEXUS_FILE_NAME.txt
download.jpg
dices.png

# Documentation files (keep local only, except README.md)
*.md
*.txt
*.html
!README.md
