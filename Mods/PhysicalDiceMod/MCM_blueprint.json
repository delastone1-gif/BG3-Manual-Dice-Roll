{
  "SchemaVersion": 1,
  "ModName": "Physical Dice Mod",
  "Optional": true,
  "Tabs": [
    {
      "TabName": "Dice Input",
      "TabId": "dice_input",
      "Sections": [
        {
          "SectionName": "Current Roll",
          "SectionId": "current_roll_section",
          "Settings": [
            {
              "Id": "current_roll_value",
              "Name": "Roll Value (1-20)",
              "Type": "slider_int",
              "Default": 10,
              "Options": {
                "Min": 1,
                "Max": 20
              },
              "Description": "Slide to set your physical d20 roll result",
              "Tooltip": "Set your roll value, then click Apply or press F9"
            },
            {
              "Id": "apply_button",
              "Name": "Apply Roll Now",
              "Type": "event_button",
              "Options": {
                "Label": "Apply Roll",
                "Icon": {
                  "Name": "Skill_Fighter_ActionSurge"
                }
              },
              "Description": "Click to apply the current roll value",
              "Tooltip": "Applies the roll value you entered above"
            },
            {
              "Id": "auto_apply_on_turn",
              "Name": "Auto-Apply on Your Turn",
              "Type": "checkbox",
              "Default": false,
              "Description": "Automatically apply the roll value when your turn starts",
              "Tooltip": "If enabled, the roll will apply immediately when your turn begins"
            }
          ]
        },
        {
          "SectionName": "Quick Roll Buttons",
          "SectionId": "quick_buttons",
          "Settings": [
            {
              "Id": "quick_roll_1",
              "Name": "Critical Fail (1)",
              "Type": "event_button",
              "Options": {
                "Label": "Roll 1",
                "Icon": {
                  "Name": "Spell_Necromancy_InflictWounds"
                }
              },
              "Description": "Set roll to 1",
              "Tooltip": "Click to set your roll to 1"
            },
            {
              "Id": "quick_roll_10",
              "Name": "Average (10)",
              "Type": "event_button",
              "Options": {
                "Label": "Roll 10",
                "Icon": {
                  "Name": "Spell_Divination_Guidance"
                }
              },
              "Description": "Set roll to 10",
              "Tooltip": "Click to set your roll to 10"
            },
            {
              "Id": "quick_roll_20",
              "Name": "Critical Success (20)",
              "Type": "event_button",
              "Options": {
                "Label": "Roll 20",
                "Icon": {
                  "Name": "Spell_Abjuration_Shield"
                }
              },
              "Description": "Set roll to 20",
              "Tooltip": "Click to set your roll to 20"
            }
          ]
        },
        {
          "SectionName": "Hotkeys",
          "SectionId": "hotkeys",
          "Settings": [
            {
              "Id": "apply_roll_hotkey",
              "Name": "Apply Roll",
              "Type": "keybinding_v2",
              "Default": {
                "Keyboard": {
                  "Key": "F9"
                }
              },
              "Description": "Hotkey to apply the current roll value",
              "Tooltip": "Press this key to immediately apply your roll"
            },
            {
              "Id": "clear_boost_hotkey",
              "Name": "Clear Boost",
              "Type": "keybinding_v2",
              "Default": {
                "Keyboard": {
                  "Key": "F10"
                }
              },
              "Description": "Hotkey to clear active boost",
              "Tooltip": "Press this key to remove the active boost"
            },
            {
              "Id": "increment_roll_hotkey",
              "Name": "Increment Roll (+1)",
              "Type": "keybinding_v2",
              "Default": {
                "Keyboard": {
                  "Key": "EQUALS"
                }
              },
              "Description": "Increase roll value by 1",
              "Tooltip": "Press to increase the roll value"
            },
            {
              "Id": "decrement_roll_hotkey",
              "Name": "Decrement Roll (-1)",
              "Type": "keybinding_v2",
              "Default": {
                "Keyboard": {
                  "Key": "MINUS"
                }
              },
              "Description": "Decrease roll value by 1",
              "Tooltip": "Press to decrease the roll value"
            }
          ]
        },
        {
          "SectionName": "Display Options",
          "SectionId": "display_options",
          "Settings": [
            {
              "Id": "show_notifications",
              "Name": "Show Notifications",
              "Type": "checkbox",
              "Default": true,
              "Description": "Display on-screen notifications for roll changes",
              "Tooltip": "Show visual feedback when rolls are applied or cleared"
            },
            {
              "Id": "verbose_logging",
              "Name": "Verbose Console Logging",
              "Type": "checkbox",
              "Default": false,
              "Description": "Enable detailed logging in console (F3)",
              "Tooltip": "Useful for debugging or seeing detailed information"
            }
          ]
        }
      ]
    },
    {
      "TabName": "About",
      "TabId": "about",
      "Sections": [
        {
          "SectionName": "Mod Information",
          "SectionId": "mod_info",
          "Settings": [
            {
              "Id": "about_text",
              "Name": "Physical Dice Mod",
              "Type": "text",
              "Default": "Version 1.1.0\n\nAllows you to use physical dice rolls in Baldur's Gate 3.\n\nHow to use:\n1. Roll your physical d20\n2. Set the value using the slider or hotkeys\n3. Press Apply Roll hotkey (F9) or let it auto-apply\n4. Make your in-game roll\n\nConsole commands still work:\n!setroll <1-20> - Set roll value\n!checkroll - Check status\n!clearroll - Clear boost",
              "Description": "",
              "Tooltip": ""
            }
          ]
        }
      ]
    }
  ]
}
